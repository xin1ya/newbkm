{
  "name": "cuilan-archipelago",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "翠澜群岛 · 3D 半开放世界宝可梦同人（内部学习项目，不公开发布）",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "node scripts/copy-decoders.mjs && vite",
    "build": "node scripts/copy-decoders.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=smoke",
    "test:perf": "playwright test --project=perf",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "gen:sprout": "tsx scripts/gen-sprout.ts",
    "gen:tide": "tsx scripts/gen-tide.ts",
    "gen:tms": "tsx scripts/gen-tms.ts",
    "data:moves": "tsx scripts/augment-moves.ts",
    "validate": "tsx scripts/validate.ts",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "models:build": "tsx scripts/build-models.ts"
  },
  "dependencies": {
    "fast-png": "^6.2.0",
    "lil-gui": "^0.20.0",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
